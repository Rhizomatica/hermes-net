[Unit]
Description=sBitx controller daemon
# sbitx_controller and hermes-radio-daemon drive the same radio and share
# its shared memory, codec and ports: only one of them can run.
Conflicts=radiod.service
After=sound.target

[Service]
Type=exec
ExecStart=/usr/bin/sbitx_controller
KillSignal=SIGTERM
IgnoreSIGPIPE=no
Restart=always
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
