[Unit]
Description=HERMES open modem (mercury) daemon
# The radio controller (sbitx_controller or hermes-radio-daemon) is
# hermes-radio.service, an alias for the one the station runs.  The modem
# shares its snd-aloop cables, which take their period size from whichever end
# opens them first, so the controller has to open them first: start after it,
# restart with it, and wait for its audio (wait_radio_audio.sh).
After=sound.target hermes-radio.service ubitx.service
PartOf=hermes-radio.service

[Service]
Type=exec
User=root
Group=root
ExecStartPre=-/usr/lib/hermes-net/wait_radio_audio.sh
ExecStart=/usr/bin/mercury -v -C /etc/mercury/mercury.ini
KillSignal=SIGTERM
IgnoreSIGPIPE=no
Restart=always

[Install]
WantedBy=multi-user.target
